# Build outputs (regenerated by `make` from src/)
/work/
/dist/
/.sidekick/

# Inside the sub-flakes: nix-build gc-roots (result-*) and per-target
# install stamps (.*-installed).  Everything else under flakes/ is
# source and stays tracked.
/flakes/**/result*
/flakes/**/.*-installed

# Claude Code per-project state — keep it out of the repo
/.claude/

# We don't ship .envrc, but be defensive: if a developer keeps a
# personal one (e.g. for editor LSP wiring), nix-direnv's runtime
# state shouldn't sneak into commits.
/.direnv/

# Makefile-managed gc-roots for `nix develop -i --profile` dispatch.
# One entry per ARCH; pins the dev-shell closure so nix-store gc
# doesn't reclaim it between Makefile invocations.
/.gcroots/

# Editor / OS noise
.DS_Store
*.swp
*~
