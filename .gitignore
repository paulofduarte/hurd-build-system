# Build outputs (regenerated by `make` from src/)
/work/
/dist/

# Toolchain — the nix flake sources for gnumach-headers + mig are
# tracked; per-target build outputs (symlinks + result/) are not.
/toolchain/*
!/toolchain/gnumach-headers/
!/toolchain/mig/
/toolchain/gnumach-headers/result*
/toolchain/mig/result*

# Claude Code per-project state — keep it out of the repo
/.claude/

# Editor / OS noise
.DS_Store
*.swp
*~
