# Build outputs (regenerated by `make` from src/)
/work/
/dist/

# Toolchain — the nix flake sources for gnumach-headers + mig are
# tracked; per-target build outputs (symlinks + result/) are not.
/toolchain/*
!/toolchain/cross-gcc/
!/toolchain/gnumach-headers/
!/toolchain/mig/
/toolchain/gnumach-headers/result*
/toolchain/mig/result*

# Claude Code per-project state — keep it out of the repo
/.claude/

# direnv / nix-direnv per-project state (profile gc-roots, env cache).
/.direnv/

# Makefile-managed gc-roots for `nix develop -i --profile` dispatch.
# One entry per TARGET; kept out of .direnv/ so nix-direnv's reload
# cleanup doesn't wipe them.
/.gcroots/

# Editor / OS noise
.DS_Store
*.swp
*~
